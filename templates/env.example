# Public site configuration
NEXT_PUBLIC_SITE_URL=https://hendricks.ai
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_VERCEL_ENV=development

# Optional measurement — empty keeps tags unloaded (no invented IDs).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01
SANITY_READ_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=

# Lead email delivery
RESEND_API_KEY=
LEAD_FROM_EMAIL=Hendricks Website <website@hendricks.ai>
LEAD_NOTIFICATION_EMAIL=

# Optional CRM webhook
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Optional spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional rate-limit provider
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# Public-mini observation queue. Redis optional. No DataForSEO keys here.
OBSERVE_JOB_STORE=
OBSERVE_IP_RATE_LIMIT=
OBSERVE_FIXTURE=0
OBSERVE_WORKER_SECRET=
OBSERVE_COST_CEILING_USD=2
