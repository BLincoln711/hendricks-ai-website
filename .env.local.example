# Google Tag Manager ID
# Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Public probe — server only. Never expose these to the client.
# If these are unset, the gate still ships: extractability + an empty board.

# DataForSEO: the dashboard Base64 string is already a Basic token.
# Do not double-encode it. Prefer DATAFORSEO_BASIC_TOKEN, or login + password.
DATAFORSEO_BASIC_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ChatGPT web-search probe
OPENAI_API_KEY=

# Optional model override for the ChatGPT probe
# OPENAI_PROBE_MODEL=gpt-4o
