{
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/reports/fuse-workspace",
      "destination": "https://storage.googleapis.com/fuse-workspace-reports/latest/index.html"
    },
    {
      "source": "/reports/fuse-workspace/",
      "destination": "https://storage.googleapis.com/fuse-workspace-reports/latest/index.html"
    },
    {
      "source": "/reports/fuse-workspace/:path*",
      "destination": "https://storage.googleapis.com/fuse-workspace-reports/:path*"
    }
  ]
}