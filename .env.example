# Public site configuration
NEXT_PUBLIC_SITE_URL=https://hendricks.ai
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_VERCEL_ENV=development

# Optional measurement — leave empty to keep tags unloaded.
# Both still require analytics consent via Privacy Choices.
# Set these in Vercel only when a real ID exists. Do not invent values.
# NEXT_PUBLIC_GA_MEASUREMENT_ID: GA4 web stream (format G-XXXXXXXX).
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID: LinkedIn Insight partner ID (digits).
# Do not set the LinkedIn ID in production until the Privacy Notice names it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Sanity — required from Phase 6
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01
SANITY_READ_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=

# Lead delivery for the three inquiry forms. All three are required together.
# With any one of them missing, and no CRM webhook configured, the server action
# fails closed: it returns the delivery error and never reports a success it
# could not deliver (decision D-H). The names of the missing variables are
# written to the server log; no value is ever printed.
# LEAD_NOTIFICATION_EMAIL is the monitored inbox, brandon@hendricks.ai.
RESEND_API_KEY=
LEAD_FROM_EMAIL=Hendricks Website <website@hendricks.ai>
LEAD_NOTIFICATION_EMAIL=

# Optional CRM webhook. A second durable destination for the same submission.
# When the secret is set the body is signed as x-hendricks-signature, an
# HMAC-SHA256 hex digest of the JSON payload.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Optional spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared store for the rate limit and the idempotency bucket.
# Required for either to hold across serverless instances (15 blocker 3).
# RATE_LIMIT_REDIS_URL is the Upstash Redis REST endpoint, not a redis:// URL.
# RATE_LIMIT_HASH_SECRET must be at least 32 characters and is rotated
# quarterly; rotating it expires every key in the store, which is the intended
# way to clear the table.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
RATE_LIMIT_HASH_SECRET=

# Public-mini /observe queue (PR2 bridge). Redis is optional and not required
# to build or merge. RATE_LIMIT_REDIS_* above is reused when both are set.
# Those values are not on Vercel today. Production Redis needs Brandon-approved
# env. Do not put DataForSEO or Ultra probe credentials in this app.
# OBSERVE_JOB_STORE: memory (default) | fs | redis
# OBSERVE_FIXTURE: 1 loads a labeled non-production filled fixture. Never set
# this in production. Default boards stay pending or unmeasured.
# OBSERVE_WORKER_SECRET: bearer token for POST /api/observe/jobs/:jobId/cells
OBSERVE_JOB_STORE=
OBSERVE_FIXTURE=0
OBSERVE_WORKER_SECRET=
OBSERVE_COST_CEILING_USD=2
