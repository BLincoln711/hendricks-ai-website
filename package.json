    "brand:build": "tsx scripts/build-brand-assets.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:content": "tsx scripts/validate-content.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:content && pnpm check:links && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "geist": "^1.6.1",
