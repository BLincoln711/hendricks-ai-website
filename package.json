    "zod": "^4.1.13",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.1",
    "class-variance-authority": "^0.7.1",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.0"
  },
  "devDependencies": {
